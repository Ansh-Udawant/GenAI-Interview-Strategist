NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_32_chars
ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

RESET_PASSWORD_SECRET=your_reset_password_secret_here_min_32_chars
RESET_PASSWORD_EXPIRY=15m

GOOGLE_GENAI_API_KEY=your_google_genai_api_key

CLOUDINARY_URL=imageURL

# Email Config - Google Mail OAuth2
GOOGLE_MAIL_CLIENT_ID=your_google_mail_client_id
GOOGLE_MAIL_CLIENT_SECRET=your_google_mail_client_secret
GOOGLE_MAIL_REFRESH_TOKEN=your_google_mail_refresh_token
GOOGLE_MAIL_USER=your_email@gmail.com
SUPPORT_EMAIL=your_email@gmail.com


CLIENT_URL=http://localhost:5173
